  "official_excerpts": [
    {
      "source": "https://resources.arc.net/hc/en-us/articles/20498377604887-Arc-for-macOS-2023-Release-Notes",
      "title": "Arc for macOS - 2023 Release Notes",
      "section": "## November 30, 2023 —",
      "source_text_line": 48,
      "text": "* Little Arc Windows now auto-archive every 6 hours by default. You can edit this setting in Arc > Settings > General. You can view all archived tabs by hitting CMD T and typing \"View Archive\". Filter for Little Arc.",
      "saved_file": "official-docs/20498377604887.md"
    },
    {
      "source": "https://resources.arc.net/hc/en-us/articles/20498377604887-Arc-for-macOS-2023-Release-Notes",
      "title": "Arc for macOS - 2023 Release Notes",
      "section": "## November 2, 2023 —",
      "source_text_line": 96,
      "text": "* If you click the same link within an external app, we'll simply resurface the existing Little Arc window instead of creating a duplicate one.",
      "saved_file": "official-docs/20498377604887.md"
    },
    {
      "source": "https://resources.arc.net/hc/en-us/articles/20498377604887-Arc-for-macOS-2023-Release-Notes",
      "title": "Arc for macOS - 2023 Release Notes",
      "section": "## November 2, 2023 —",
      "source_text_line": 97,
      "text": "* Little Arc will now remember the profile you select for a given domain. New links within that domain will have the profile automatically selected.",
      "saved_file": "official-docs/20498377604887.md"
    },
    {
      "source": "https://resources.arc.net/hc/en-us/articles/20498377604887-Arc-for-macOS-2023-Release-Notes",
      "title": "Arc for macOS - 2023 Release Notes",
      "section": "## October 12, 2023 —",
      "source_text_line": 144,
      "text": "* You can now have multiple Little Arc windows open at once! You'll also notice improvements to design and Little Arc opening animations.",
      "saved_file": "official-docs/20498377604887.md"
    },
    {
      "source": "https://resources.arc.net/hc/en-us/articles/20498377604887-Arc-for-macOS-2023-Release-Notes",
      "title": "Arc for macOS - 2023 Release Notes",
      "section": "## Jan 19, 2023 —",
      "source_text_line": 690,
      "text": "* Little Arc will now always appear above your full screen window, that way it won't get lost.",
      "saved_file": "official-docs/20498377604887.md"
    }
