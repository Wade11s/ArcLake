  "official_excerpts": [
    {
      "source": "https://resources.arc.net/hc/en-us/articles/19228855311127-Auto-Archive-Clean-as-you-go",
      "title": "Auto Archive: Clean as you go",
      "section": "## Adjust Auto Archive Timing",
      "source_text_line": 21,
      "text": "By default, idle Unpinned Tabs archive every 12 hours. Viewing or clicking on a tab will always reset the timer! You can select a different Archive timing for each Profile you have, if you like. By default, all Profiles will share the same timing as your \"Default\" Profile.",
      "saved_file": "official-docs/19228855311127.md"
    },
    {
      "source": "https://resources.arc.net/hc/en-us/articles/19228855311127-Auto-Archive-Clean-as-you-go",
      "title": "Auto Archive: Clean as you go",
      "section": "## Can Auto Archive be disabled?",
      "source_text_line": 45,
      "text": "Auto Archive can't be disabled.",
      "saved_file": "official-docs/19228855311127.md"
    },
    {
      "source": "https://resources.arc.net/hc/en-us/articles/19228855311127-Auto-Archive-Clean-as-you-go",
      "title": "Auto Archive: Clean as you go",
      "section": "## View & Restore Archived Tabs",
      "source_text_line": 7,
      "text": "**View Archived Tabs:** hit Command-T (macOS) or Control-T (Windows) and type \"View Archive.\"",
      "saved_file": "official-docs/19228855311127.md"
    },
    {
      "source": "https://resources.arc.net/hc/en-us/articles/19228855311127-Auto-Archive-Clean-as-you-go",
      "title": "Auto Archive: Clean as you go",
      "section": "## Restore Archived Tabs",
      "source_text_line": 13,
      "text": "You can restore tabs by heading to the Archive (Command-T / View Archive) and hitting the Restore icon next to any archived tab.",
      "saved_file": "official-docs/19228855311127.md"
    },
    {
      "source": "https://resources.arc.net/hc/en-us/articles/19228855311127-Auto-Archive-Clean-as-you-go",
      "title": "Auto Archive: Clean as you go",
      "section": "## Restore Archived Tabs",
      "source_text_line": 17,
      "text": "You can restore tabs by heading to the Archive (Control-T / View Archive) and clicking on any archived tab.",
      "saved_file": "official-docs/19228855311127.md"
    },
    {
      "source": "https://resources.arc.net/hc/en-us/articles/19228855311127-Auto-Archive-Clean-as-you-go",
      "title": "Auto Archive: Clean as you go",
      "section": "## Clear the Archive",
      "source_text_line": 37,
      "text": "To remove all archived tabs at once, just right-click the Archive Tabs box in the Library and select \"Clear Archive.\" You can also do this from the Command Bar (Command-T) by typing \"clear archive\" and hitting enter.",
